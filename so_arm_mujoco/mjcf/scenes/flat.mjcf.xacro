<?xml version="1.0"?>
<!-- Bare skybox + floor, no objects - the scene:=flat default. Moved out of so_arm.mjcf.xacro
     so multiple named scenes (see arena.mjcf.xacro) can share the file layout convention
     rather than growing as ever more xacro:if branches in the main model file. -->
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">
  <statistic center="0.1 -0.01 0.05" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20"/>
    <!-- How far the wrist_cam frustum is *drawn* when the viewer's Camera visualization is
         on - purely cosmetic, unrelated to the camera's actual fovy/calibration or to what
         it renders. MuJoCo's default (10) is well past saturation at this model's 0.5m
         extent, so the frustum swamps the arm; 2 keeps it legible at roughly half the
         on-screen footprint. Lower it further (1 is small but still visible) to taste. -->
    <scale frustum="2"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
