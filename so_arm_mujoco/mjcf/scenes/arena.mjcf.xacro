<?xml version="1.0"?>
<!-- A small tabletop workspace, not lekiwi_mujoco/pt_mujoco's walled-room-with-obstacles arena
     (that's for navigation-recovery testing on a mobile base - irrelevant to a stationary arm
     bolted to one spot). Three free (grippable) cubes and a static tray, all placed within
     SO101's reach at tabletop height: a random sweep of shoulder_pan/lift/elbow/wrist_flex
     within their joint ranges puts the end effector at roughly radius 0.0-0.46m around the
     base for z in [0, 0.08] (matches teleop.yaml's own max_target_reach: 0.45 closely).
     Positions below sit at 0.14-0.26m, well inside that envelope without needing extreme
     joint angles to reach. -->
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">
  <statistic center="0.1 -0.01 0.05" extent="0.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="45" elevation="-20"/>
    <scale frustum="2"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="tray" rgba="0.55 0.55 0.58 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- 3cm cubes, light enough (density-derived mass) for the gripper to lift without
         fighting its own inertia; friction raised from MuJoCo's default so a light grip
         doesn't slide the cube out before the gripper closes fully. -->
    <body name="cube_red" pos="0.22 0.12 0.015">
      <freejoint/>
      <geom type="box" size="0.015 0.015 0.015" rgba="0.85 0.2 0.15 1" density="500"
            friction="1.0 0.005 0.0001"/>
    </body>
    <body name="cube_green" pos="0.20 -0.10 0.015">
      <freejoint/>
      <geom type="box" size="0.015 0.015 0.015" rgba="0.2 0.7 0.25 1" density="500"
            friction="1.0 0.005 0.0001"/>
    </body>
    <body name="cube_blue" pos="0.26 0.0 0.015">
      <freejoint/>
      <geom type="box" size="0.015 0.015 0.015" rgba="0.2 0.35 0.85 1" density="500"
            friction="1.0 0.005 0.0001"/>
    </body>

    <!-- Static drop zone (no freejoint) - a shallow open-top tray for pick-and-place practice,
         off to one side so it isn't in the way of the cubes above. -->
    <body name="tray" pos="0.14 -0.24 0">
      <geom type="box" size="0.05 0.05 0.002" pos="0 0 0.002" material="tray"/>
      <geom type="box" size="0.05 0.005 0.015" pos="0 0.045 0.015" material="tray"/>
      <geom type="box" size="0.05 0.005 0.015" pos="0 -0.045 0.015" material="tray"/>
      <geom type="box" size="0.005 0.05 0.015" pos="0.045 0 0.015" material="tray"/>
      <geom type="box" size="0.005 0.05 0.015" pos="-0.045 0 0.015" material="tray"/>
    </body>
  </worldbody>
</mujoco>
