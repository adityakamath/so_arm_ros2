<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>so_arm_mujoco</name>
  <version>0.0.0</version>
  <description>Standalone MuJoCo simulation (no ROS required) for SO-ARM100 (SO100 and SO101), with optional Gymnasium single-arm and vectorized N-arm training envs</description>
  <maintainer email="adityakamath@live.com">adityakamath</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>so_arm_description</exec_depend>

  <!-- mujoco (and gymnasium, for the [gym] extra) are pip-only - see requirements.txt and
       scripts/bootstrap_external_deps.sh, same pattern as so_arm_control's python-fcl. -->

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
