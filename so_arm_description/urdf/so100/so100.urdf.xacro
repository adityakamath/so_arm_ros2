<?xml version="1.0"?>
<robot name="so100" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find so_arm_description)/urdf/so100/so100.common.xacro"/>
  <xacro:include filename="$(find so_arm_description)/urdf/so100/so100.control.xacro"/>

  <!-- Arguments (externally settable, default to property values in so100.control.xacro) -->
  <xacro:arg name="serial_port"    default="${serial_port}"/>
  <xacro:arg name="use_mock"       default="${use_mock}"/>
  <xacro:arg name="use_sync_write" default="${use_sync_write}"/>
  <xacro:arg name="arm_operating_mode"     default="${arm_operating_mode}"/>     <!-- 0=Position 1=Velocity 2=PWM; arm joints 1-5; baked at startup -->
  <xacro:arg name="gripper_operating_mode" default="${gripper_operating_mode}"/> <!-- 0=Position 1=Velocity 2=PWM; gripper joint 6; baked at startup -->

  <!-- real=STS serial plugin, mujoco=MujocoSystemInterface, mock_components=GenericSystem. -->
  <xacro:arg name="ros2_control_hardware_type" default="real"/>
  <!-- mujoco only -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="mujoco_headless" default="false"/>

  <material name="light_grey">
    <color rgba="${light_grey_rgba}"/>
  </material>
  <material name="charcoal">
    <color rgba="${charcoal_rgba}"/>
  </material>

  <!-- LINKS -->

  <!-- Dummy root link (KDL does not support inertia on root link) -->
  <link name="base_footprint"/>
  <joint name="world_to_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base link -->
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Base.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Base_Motor.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Base.stl"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 ${base_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Base_Motor.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Shoulder link -->
  <link name="shoulder_link">
    <inertial>
      <mass value="0.119226"/>
      <origin xyz="-9.07886e-05 -0.031089 0.0590972" rpy="0 0 0"/>
      <inertia ixx="5.94278e-05" ixy="0" ixz="0" iyy="3.13712e-05" iyz="0" izz="5.89975e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="${shoulder_offset_rx} 0 ${shoulder_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Rotation_Pitch.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="${shoulder_offset_rx} 0 ${shoulder_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Rotation_Pitch_Motor.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${shoulder_offset_rx} 0 ${shoulder_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Rotation_Pitch.stl"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="${shoulder_offset_rx} 0 ${shoulder_offset_rz}"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Rotation_Pitch_Motor.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Upper arm link -->
  <link name="upper_arm_link">
    <inertial>
      <mass value="0.162409"/>
      <origin xyz="-0.00310545 0.0701802 -1.72052e-05" rpy="0 0 0"/>
      <inertia ixx="7.01522e-05" ixy="0" ixz="0" iyy="0.000167164" iyz="0" izz="0.000213312"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 ${upper_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Upper_Arm.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 ${upper_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Upper_Arm_Motor.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${upper_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Upper_Arm.stl"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${upper_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Upper_Arm_Motor.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Lower arm link -->
  <link name="lower_arm_link">
    <inertial>
      <mass value="0.147968"/>
      <origin xyz="-0.0768007 0.00137796 -0.00339604" rpy="0 0 0"/>
      <inertia ixx="4.84242e-05" ixy="0" ixz="0" iyy="0.000107748" iyz="0" izz="0.000138803"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 ${lower_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Lower_Arm.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 ${lower_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Lower_Arm_Motor.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${lower_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Lower_Arm.stl"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${lower_arm_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Lower_Arm_Motor.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Wrist link -->
  <link name="wrist_link">
    <inertial>
      <mass value="0.0661321"/>
      <origin xyz="2.34622e-05 -0.0352279 -0.00852653" rpy="0 0 0"/>
      <inertia ixx="1.94704e-05" ixy="0" ixz="0" iyy="2.39041e-05" iyz="0" izz="3.45403e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 ${wrist_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Wrist_Pitch_Roll.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <visual>
      <origin xyz="0 0 0" rpy="0 ${wrist_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Wrist_Pitch_Roll_Motor.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${wrist_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Wrist_Pitch_Roll.stl"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${wrist_visual_ry} 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Wrist_Pitch_Roll_Motor.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Gripper link (fixed jaw) -->
  <link name="gripper_link">
    <inertial>
      <mass value="0.0929859"/>
      <origin xyz="0.00552377 -0.000483583 -0.0280167" rpy="0 0 0"/>
      <inertia ixx="5.03136e-05" ixy="0" ixz="0" iyy="2.72961e-05" iyz="0" izz="4.64098e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="${gripper_visual_rx} 0 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Fixed_Jaw.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${gripper_visual_rx} 0 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Fixed_Jaw.stl"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0" rpy="${gripper_visual_rx} 0 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Fixed_Jaw_Motor.stl"/>
      </geometry>
      <material name="charcoal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${gripper_visual_rx} 0 0"/>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Fixed_Jaw_Motor.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- End effector frame (dummy link) -->
  <link name="end_effector_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1e-9"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
    </inertial>
  </link>

  <!-- Moving jaw link -->
  <link name="moving_jaw_link">
    <inertial>
      <mass value="0.0202444"/>
      <origin xyz="-0.00161745 -0.0303473 0.000449646" rpy="0 0 0"/>
      <inertia ixx="1.11265e-05" ixy="0" ixz="0" iyy="8.99651e-06" iyz="0" izz="2.99548e-06"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Moving_Jaw.stl"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://so_arm_description/meshes/so100/Moving_Jaw.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- JOINTS -->

  <!-- velocity="1e6" (unreachable) disables JointSaturationLimiter's clipping - the real
       ceiling comes from max_velocity in the <ros2_control> block below. -->

  <joint name="shoulder_pan_joint" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="${shoulder_pan_xyz}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${shoulder_pan_lower}" upper="${shoulder_pan_upper}" effort="${max_torque_nm}" velocity="1e6"/>
  </joint>

  <joint name="shoulder_lift_joint" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="${shoulder_lift_xyz}" rpy="${shoulder_lift_rpy}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${shoulder_lift_lower}" upper="${shoulder_lift_upper}" effort="${max_torque_nm}" velocity="1e6"/>
  </joint>

  <joint name="elbow_flex_joint" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="lower_arm_link"/>
    <origin xyz="${elbow_flex_xyz}" rpy="${elbow_flex_rpy}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${elbow_flex_lower}" upper="${elbow_flex_upper}" effort="${max_torque_nm}" velocity="1e6"/>
  </joint>

  <joint name="wrist_flex_joint" type="revolute">
    <parent link="lower_arm_link"/>
    <child link="wrist_link"/>
    <origin xyz="${wrist_flex_xyz}" rpy="${wrist_flex_rpy}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${wrist_flex_lower}" upper="${wrist_flex_upper}" effort="${max_torque_nm}" velocity="1e6"/>
  </joint>

  <joint name="wrist_roll_joint" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="${wrist_roll_xyz}" rpy="${wrist_roll_rpy}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${wrist_roll_lower}" upper="${wrist_roll_upper}" effort="${max_torque_nm}" velocity="1e6"/>
  </joint>

  <joint name="gripper_joint" type="revolute">
    <parent link="gripper_link"/>
    <child link="moving_jaw_link"/>
    <origin xyz="${gripper_xyz}" rpy="${gripper_rpy}"/>
    <axis xyz="0 0 1"/>
    <limit lower="${gripper_lower}" upper="${gripper_upper}" effort="${max_torque_nm}" velocity="1e6"/>
  </joint>

  <joint name="end_effector_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="end_effector_link"/>
    <origin xyz="${end_effector_xyz}" rpy="${end_effector_rpy}"/>
  </joint>

  <!-- ROS 2 CONTROL -->
  <ros2_control name="so100_control" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mujoco'}">
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg mujoco_headless)</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mock_components'}">
        <plugin>mock_components/GenericSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">${baud_rate}</param>
        <param name="communication_timeout_ms">100</param>
        <param name="use_sync_write">$(arg use_sync_write)</param>
        <param name="enable_mock_mode">$(arg use_mock)</param>
        <param name="reset_states_on_activate">true</param>
      </xacro:if>
    </hardware>

    <joint name="shoulder_pan_joint">
      <param name="motor_id">${shoulder_pan_motor_id}</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${shoulder_pan_lower}</param>
      <param name="max_position">${shoulder_pan_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">${p_coefficient}</param>
      <param name="d_coefficient">${d_coefficient}</param>
      <param name="i_coefficient">${i_coefficient}</param>
      <param name="deadband">${deadband}</param>
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="shoulder_lift_joint">
      <param name="motor_id">${shoulder_lift_motor_id}</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${shoulder_lift_lower}</param>
      <param name="max_position">${shoulder_lift_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">${p_coefficient}</param>
      <param name="d_coefficient">${d_coefficient}</param>
      <param name="i_coefficient">${i_coefficient}</param>
      <param name="deadband">${deadband}</param>
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="elbow_flex_joint">
      <param name="motor_id">${elbow_flex_motor_id}</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${elbow_flex_lower}</param>
      <param name="max_position">${elbow_flex_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">${p_coefficient}</param>
      <param name="d_coefficient">${d_coefficient}</param>
      <param name="i_coefficient">${i_coefficient}</param>
      <param name="deadband">${deadband}</param>
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="wrist_flex_joint">
      <param name="motor_id">${wrist_flex_motor_id}</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${wrist_flex_lower}</param>
      <param name="max_position">${wrist_flex_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">${p_coefficient}</param>
      <param name="d_coefficient">${d_coefficient}</param>
      <param name="i_coefficient">${i_coefficient}</param>
      <param name="deadband">${deadband}</param>
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="wrist_roll_joint">
      <param name="motor_id">${wrist_roll_motor_id}</param>
      <param name="operating_mode">$(arg arm_operating_mode)</param>
      <param name="min_position">${wrist_roll_lower}</param>
      <param name="max_position">${wrist_roll_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">${p_coefficient}</param>
      <param name="d_coefficient">${d_coefficient}</param>
      <param name="i_coefficient">${i_coefficient}</param>
      <param name="deadband">${deadband}</param>
      <!-- cmd interfaces depend on arm_operating_mode -->
      <xacro:if value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg arm_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <joint name="gripper_joint">
      <param name="motor_id">${gripper_motor_id}</param>
      <param name="operating_mode">$(arg gripper_operating_mode)</param>
      <param name="min_position">${gripper_lower}</param>
      <param name="max_position">${gripper_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts_protocol_max_vel_steps}</param>
      <param name="max_velocity">${max_velocity_rads}</param>
      <param name="position_center_steps">2048</param>
      <param name="p_coefficient">${p_coefficient}</param>
      <param name="d_coefficient">${d_coefficient}</param>
      <param name="i_coefficient">${i_coefficient}</param>
      <param name="deadband">${deadband}</param>
      <!-- cmd interfaces depend on gripper_operating_mode -->
      <xacro:if value="${'$(arg gripper_operating_mode)' == '2'}">
        <command_interface name="effort"/>
      </xacro:if>
      <xacro:unless value="${'$(arg gripper_operating_mode)' == '2'}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
      </xacro:unless>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- real hardware only -->
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>
  </ros2_control>

</robot>
