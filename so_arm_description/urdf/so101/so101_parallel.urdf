      <param name="i_coefficient">0</param>
      <param name="deadband">10</param>
      <command_interface name="position"/>
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="voltage"/>
      <state_interface name="temperature"/>
      <state_interface name="current"/>
      <state_interface name="is_moving"/>
    </joint>
    <joint name="gripper_joint">
      <param name="motor_id">6</param>
      <param name="operating_mode">0</param>
      <param name="min_position">-5.285714285714286</param>
      <param name="max_position">0</param>
