<?xml version="1.0"?>
<!-- Parametric SO-100/SO-101 MJCF assembly (mujoco_ros2_control equivalent of
     so100.urdf.xacro / so101.urdf.xacro): defines the so_arm100_body / so_arm101_body macros,
     selected by so_arm_config, and when standalone:=true (default) invokes the selected one
     in worldbody plus a floor/lighting scene. Mirrors pantilt_ros2's pantilt.mjcf.xacro
     (pt_description/mjcf/pantilt.mjcf.xacro) pattern.

     Standalone: xacro so_arm.mjcf.xacro so_arm_config:=so101 > /tmp/so_arm.xml
     so_arm_control/launch/control.launch.py runs the same command at launch time.

     Body positions/orientations and inertials are taken from so_arm_description's own
     URDF sources (so100.common.xacro/so100.urdf.xacro and so101.common.xacro/
     so101.urdf.xacro) - not ported wholesale from ros2_so_arm's or MuJoCo Menagerie's MJCF
     files, which use a different (rotated) joint-axis convention for SO-100 and, for SO-101,
     an extra ~10 degree gripper-pitch offset not present in the upstream CAD-exported URDF.
     Using the same numbers as our own URDF keeps position commands identical in meaning
     between the real STS hardware and this MuJoCo simulation.

     Joint dynamics/actuators live in so_arm_shared.xml (variant-independent - joint names are
     identical between SO-100 and SO-101). Only meshes, body geometry, joint ranges and contact
     excludes differ per variant, and are declared below the corresponding xacro:if branch. -->
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro" model="so_arm">
  <xacro:arg name="so_arm_config" default="so101"/>
  <xacro:arg name="standalone" default="true"/>
  <xacro:property name="so_arm_config" value="$(arg so_arm_config)"/>

  <!-- xacro:include, not a plain <include> - so_arm_shared.xml is variant-independent. -->
  <xacro:include filename="$(find so_arm_description)/mjcf/so_arm_shared.xml"/>

  <xacro:if value="${so_arm_config == 'so100'}">
    <asset>
      <mesh name="Base" file="$(find so_arm_description)/meshes/so100/Base.stl"/>
      <mesh name="Base_Motor" file="$(find so_arm_description)/meshes/so100/Base_Motor.stl"/>
      <mesh name="Rotation_Pitch" file="$(find so_arm_description)/meshes/so100/Rotation_Pitch.stl"/>
      <mesh name="Rotation_Pitch_Motor" file="$(find so_arm_description)/meshes/so100/Rotation_Pitch_Motor.stl"/>
      <mesh name="Upper_Arm" file="$(find so_arm_description)/meshes/so100/Upper_Arm.stl"/>
      <mesh name="Upper_Arm_Motor" file="$(find so_arm_description)/meshes/so100/Upper_Arm_Motor.stl"/>
      <mesh name="Lower_Arm" file="$(find so_arm_description)/meshes/so100/Lower_Arm.stl"/>
      <mesh name="Lower_Arm_Motor" file="$(find so_arm_description)/meshes/so100/Lower_Arm_Motor.stl"/>
      <mesh name="Wrist_Pitch_Roll" file="$(find so_arm_description)/meshes/so100/Wrist_Pitch_Roll.stl"/>
      <mesh name="Wrist_Pitch_Roll_Motor" file="$(find so_arm_description)/meshes/so100/Wrist_Pitch_Roll_Motor.stl"/>
      <mesh name="Fixed_Jaw" file="$(find so_arm_description)/meshes/so100/Fixed_Jaw.stl"/>
      <mesh name="Fixed_Jaw_Motor" file="$(find so_arm_description)/meshes/so100/Fixed_Jaw_Motor.stl"/>
      <mesh name="Moving_Jaw" file="$(find so_arm_description)/meshes/so100/Moving_Jaw.stl"/>
    </asset>

    <!-- Joint origins/inertials below are so100.common.xacro / so100.urdf.xacro's values,
         verbatim - each joint rotates about its own local Z (so100's "all-Z" convention),
         with the child body's pos/quat carrying the compensating rotation so the mesh lands
         in the same place a naturally-oriented joint axis would. -->
    <xacro:macro name="so_arm100_body">
      <body name="base_link">
        <inertial pos="0 0 0" mass="1.0" diaginertia="0.01 0.01 0.01"/>
        <geom mesh="Base" material="light_grey" class="visual" quat="0.707107 0 0 0.707107"/>
        <geom mesh="Base_Motor" material="charcoal" class="visual" quat="0.707107 0 0 0.707107"/>
        <geom mesh="Base" class="collision" quat="0.707107 0 0 0.707107"/>

        <body name="shoulder_link" pos="0.0452 0 0.0165" quat="1 0 0 0">
          <joint name="shoulder_pan_joint" axis="0 0 1" range="-2 2" class="sts3215"/>
          <inertial pos="-9.07886e-05 -0.031089 0.0590972" mass="0.119226"
                    diaginertia="5.94278e-05 3.13712e-05 5.89975e-05"/>
          <geom mesh="Rotation_Pitch" material="light_grey" class="visual" quat="0.5 0.5 0.5 0.5"/>
          <geom mesh="Rotation_Pitch_Motor" material="charcoal" class="visual" quat="0.5 0.5 0.5 0.5"/>
          <geom mesh="Rotation_Pitch" class="collision" quat="0.5 0.5 0.5 0.5"/>

          <body name="upper_arm_link" pos="0.0306 0 0.1025" quat="0.553896 -0.553896 0.439545 0.439545">
            <joint name="shoulder_lift_joint" axis="0 0 1" range="0 3.5" class="sts3215"/>
            <inertial pos="-0.00310545 0.0701802 -1.72052e-05" mass="0.162409"
                      diaginertia="7.01522e-05 0.000167164 0.000213312"/>
            <geom mesh="Upper_Arm" material="light_grey" class="visual" quat="0.707107 0 -0.707107 0"/>
            <geom mesh="Upper_Arm_Motor" material="charcoal" class="visual" quat="0.707107 0 -0.707107 0"/>
            <geom mesh="Upper_Arm" class="collision" quat="0.707107 0 -0.707107 0"/>

            <body name="lower_arm_link" pos="-0.028 0.11257 0" quat="0.707107 0 0 0.707107">
              <joint name="elbow_flex_joint" axis="0 0 1" range="-3.14158 0" class="sts3215"/>
              <inertial pos="-0.0768007 0.00137796 -0.00339604" mass="0.147968"
                        diaginertia="4.84242e-05 0.000107748 0.000138803"/>
              <geom mesh="Lower_Arm" material="light_grey" class="visual" quat="0.707107 0 -0.707107 0"/>
              <geom mesh="Lower_Arm_Motor" material="charcoal" class="visual" quat="0.707107 0 -0.707107 0"/>
              <geom mesh="Lower_Arm" class="collision" quat="0.707107 0 -0.707107 0"/>

              <body name="wrist_link" pos="-0.1349 0.0052 0" quat="0.877583 0 0 -0.479426">
                <joint name="wrist_flex_joint" axis="0 0 1" range="-2.5 1.2" class="sts3215"/>
                <inertial pos="2.34622e-05 -0.0352279 -0.00852653" mass="0.0661321"
                          diaginertia="1.94704e-05 2.39041e-05 3.45403e-05"/>
                <geom mesh="Wrist_Pitch_Roll" material="light_grey" class="visual" quat="0.707107 0 -0.707107 0"/>
                <geom mesh="Wrist_Pitch_Roll_Motor" material="charcoal" class="visual" quat="0.707107 0 -0.707107 0"/>
                <geom mesh="Wrist_Pitch_Roll" class="collision" quat="0.707107 0 -0.707107 0"/>

                <body name="gripper_link" pos="0 -0.0601 0" quat="0.707107 -0.707107 0 0">
                  <joint name="wrist_roll_joint" axis="0 0 1" range="-3.14158 3.14158" class="sts3215"/>
                  <inertial pos="0.00552377 -0.000483583 -0.0280167" mass="0.0929859"
                            diaginertia="5.03136e-05 2.72961e-05 4.64098e-05"/>
                  <!-- No collision geom here or on moving_jaw_link below - MuJoCo-specific
                       simplification (avoids gripper contact-solver jitter); unlike the
                       URDF/FCL collision set, which does cover both jaws. -->
                  <geom mesh="Fixed_Jaw" material="light_grey" class="visual" quat="0.707107 0.707107 0 0"/>
                  <geom mesh="Fixed_Jaw_Motor" material="charcoal" class="visual" quat="0.707107 0.707107 0 0"/>

                  <!-- TCP marker, matches URDF's fixed end_effector_joint (end_effector_xyz/rpy
                       in so100.common.xacro) - estimated from Fixed_Jaw.stl, not calibrated. -->
                  <site group="5" name="end_effector_link" pos="0.0025 0.0 -0.106" quat="0.707107 0 0.707107 0"/>

                  <body name="moving_jaw_link" pos="-0.0202 0 -0.0244" quat="0 0 0.707107 0.707107">
                    <joint name="gripper_joint" axis="0 0 1" range="-0.2 2.0" class="sts3215"/>
                    <inertial pos="-0.00161745 -0.0303473 0.000449646" mass="0.0202444"
                              diaginertia="1.11265e-05 8.99651e-06 2.99548e-06"/>
                    <geom mesh="Moving_Jaw" material="light_grey" class="visual"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </xacro:macro>

    <xacro:if value="${'$(arg standalone)' == 'true'}">
      <contact>
        <exclude body1="base_link" body2="shoulder_link"/>
        <exclude body1="shoulder_link" body2="upper_arm_link"/>
        <exclude body1="upper_arm_link" body2="lower_arm_link"/>
        <exclude body1="lower_arm_link" body2="wrist_link"/>
        <exclude body1="wrist_link" body2="gripper_link"/>
        <exclude body1="gripper_link" body2="moving_jaw_link"/>
      </contact>
      <worldbody>
        <xacro:so_arm100_body/>
      </worldbody>
    </xacro:if>
  </xacro:if>

  <xacro:if value="${so_arm_config == 'so101'}">
    <asset>
      <mesh name="base_motor_holder_so101_v1" file="$(find so_arm_description)/meshes/so101/base_motor_holder_so101_v1.stl"/>
      <mesh name="base_so101_v2" file="$(find so_arm_description)/meshes/so101/base_so101_v2.stl"/>
      <mesh name="sts3215_03a_v1" file="$(find so_arm_description)/meshes/so101/sts3215_03a_v1.stl"/>
      <mesh name="waveshare_mounting_plate_so101_v2" file="$(find so_arm_description)/meshes/so101/waveshare_mounting_plate_so101_v2.stl"/>
      <mesh name="motor_holder_so101_base_v1" file="$(find so_arm_description)/meshes/so101/motor_holder_so101_base_v1.stl"/>
      <mesh name="rotation_pitch_so101_v1" file="$(find so_arm_description)/meshes/so101/rotation_pitch_so101_v1.stl"/>
      <mesh name="upper_arm_so101_v1" file="$(find so_arm_description)/meshes/so101/upper_arm_so101_v1.stl"/>
      <mesh name="under_arm_so101_v1" file="$(find so_arm_description)/meshes/so101/under_arm_so101_v1.stl"/>
      <mesh name="motor_holder_so101_wrist_v1" file="$(find so_arm_description)/meshes/so101/motor_holder_so101_wrist_v1.stl"/>
      <mesh name="sts3215_03a_no_horn_v1" file="$(find so_arm_description)/meshes/so101/sts3215_03a_no_horn_v1.stl"/>
      <mesh name="wrist_roll_pitch_so101_v2" file="$(find so_arm_description)/meshes/so101/wrist_roll_pitch_so101_v2.stl"/>
      <mesh name="wrist_roll_follower_so101_v1" file="$(find so_arm_description)/meshes/so101/wrist_roll_follower_so101_v1.stl"/>
      <mesh name="moving_jaw_so101_v1" file="$(find so_arm_description)/meshes/so101/moving_jaw_so101_v1.stl"/>
    </asset>

    <!-- Body tree/inertials ported from ros2_so_arm's so_arm101_description/mjcf/so_arm101.xml
         (verified to match so101.common.xacro/so101.urdf.xacro's own joint origins and
         inertials for every joint except gripper_joint, which is recomputed below from our
         own URDF's gripper_rpy - see file header). -->
    <xacro:macro name="so_arm101_body">
      <body name="base_link">
        <inertial pos="0.0137179 -5.19711e-05 0.0334843" mass="0.147"
                  fullinertia="0.000114686 0.000136117 0.000130364 -4.59787e-07 4.97151e-06 9.75275e-08"/>
        <geom class="visual" pos="-0.00636471 -9.94414e-05 -0.0024" quat="0.5 0.5 0.5 0.5"
              mesh="base_motor_holder_so101_v1" material="light_grey"/>
        <geom class="visual" pos="-0.00636471 -8.97657e-09 -0.0024" quat="0.5 0.5 0.5 0.5"
              mesh="base_so101_v2" material="light_grey"/>
        <geom class="visual" pos="0.0263353 -8.97657e-09 0.0437" quat="1 0 0 0"
              mesh="sts3215_03a_v1" material="charcoal"/>
        <geom class="visual" pos="-0.0309827 -0.000199441 0.0474" quat="0.5 0.5 0.5 0.5"
              mesh="waveshare_mounting_plate_so101_v2" material="light_grey"/>

        <body name="shoulder_link" pos="0.0388353 -8.97657e-09 0.0624" quat="0 0 -1 0">
          <joint axis="0 0 1" name="shoulder_pan_joint" range="-1.91986 1.91986" class="sts3215"/>
          <inertial pos="-0.0307604 -1.66727e-05 -0.0252713" mass="0.100006"
                    fullinertia="8.3759e-05 8.10403e-05 2.39783e-05 7.55525e-08 -1.16342e-06 1.54663e-07"/>
          <geom class="visual" pos="-0.0303992 0.000422241 -0.0417" quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_v1" material="charcoal"/>
          <geom class="collision" pos="-0.0303992 0.000422241 -0.0417" quat="0.5 0.5 0.5 -0.5"
                mesh="sts3215_03a_v1" material="charcoal"/>
          <geom class="visual" pos="-0.0675992 -0.000177759 0.0158499" quat="0.5 0.5 -0.5 0.5"
                mesh="motor_holder_so101_base_v1" material="light_grey"/>
          <geom class="collision" pos="-0.0675992 -0.000177759 0.0158499" quat="0.5 0.5 -0.5 0.5"
                mesh="motor_holder_so101_base_v1" material="light_grey"/>
          <geom class="visual" pos="0.0122008 2.22413e-05 0.0464" quat="0.707107 -0.707107 0 0"
                mesh="rotation_pitch_so101_v1" material="light_grey"/>
          <geom class="collision" pos="0.0122008 2.22413e-05 0.0464" quat="0.707107 -0.707107 0 0"
                mesh="rotation_pitch_so101_v1" material="light_grey"/>

          <body name="upper_arm_link" pos="-0.0303992 -0.0182778 -0.0542" quat="0.5 -0.5 -0.5 -0.5">
            <joint axis="0 0 1" name="shoulder_lift_joint" range="-1.74533 1.74533" class="sts3215"/>
            <inertial pos="-0.0898471 -0.00838224 0.0184089" mass="0.103"
                      fullinertia="4.08002e-05 0.000147318 0.000142487 -1.97819e-05 -4.03016e-08 8.97326e-09"/>
            <geom class="visual" pos="-0.11257 -0.0155 0.0187" quat="0 -0.707107 0.707107 0"
                  mesh="sts3215_03a_v1" material="charcoal"/>
            <geom class="collision" pos="-0.11257 -0.0155 0.0187" quat="0 -0.707107 0.707107 0"
                  mesh="sts3215_03a_v1" material="charcoal"/>
            <geom class="visual" pos="-0.065085 0.012 0.0182" quat="0 1 0 0"
                  mesh="upper_arm_so101_v1" material="light_grey"/>
            <geom class="collision" pos="-0.065085 0.012 0.0182" quat="0 1 0 0"
                  mesh="upper_arm_so101_v1" material="light_grey"/>

            <body name="lower_arm_link" pos="-0.11257 -0.028 0" quat="0.707107 0 0 0.707107">
              <joint axis="0 0 1" name="elbow_flex_joint" range="-1.69 1.69" class="sts3215"/>
              <inertial pos="-0.0980701 0.00324376 0.0182831" mass="0.104"
                        fullinertia="2.87438e-05 0.000159844 0.00014529 7.41152e-06 1.26409e-06 -4.90188e-08"/>
              <geom class="visual" pos="-0.0648499 -0.032 0.0182" quat="0 1 0 0"
                    mesh="under_arm_so101_v1" material="light_grey"/>
              <geom class="collision" pos="-0.0648499 -0.032 0.0182" quat="0 1 0 0"
                    mesh="under_arm_so101_v1" material="light_grey"/>
              <geom class="visual" pos="-0.0648499 -0.032 0.018" quat="0 -1 0 0"
                    mesh="motor_holder_so101_wrist_v1" material="light_grey"/>
              <geom class="collision" pos="-0.0648499 -0.032 0.018" quat="0 -1 0 0"
                    mesh="motor_holder_so101_wrist_v1" material="light_grey"/>
              <geom class="visual" pos="-0.1224 0.0052 0.0187" quat="0 0 1 0"
                    mesh="sts3215_03a_v1" material="charcoal"/>
              <geom class="collision" pos="-0.1224 0.0052 0.0187" quat="0 0 1 0"
                    mesh="sts3215_03a_v1" material="charcoal"/>

              <body name="wrist_link" pos="-0.1349 0.0052 0" quat="0.707388 0 0 -0.706825">
                <joint axis="0 0 1" name="wrist_flex_joint" range="-1.65806 1.65806" class="sts3215"/>
                <inertial pos="-0.000103312 -0.0386143 0.0281156" mass="0.079"
                          fullinertia="3.68263e-05 2.5391e-05 2.1e-05 1.7893e-08 -5.28128e-08 3.6412e-06"/>
                <geom class="visual" pos="0 -0.0424 0.0306" quat="0.5 0.5 0.5 -0.5"
                      mesh="sts3215_03a_no_horn_v1" material="charcoal"/>
                <geom class="collision" pos="0 -0.0424 0.0306" quat="0.5 0.5 0.5 -0.5"
                      mesh="sts3215_03a_no_horn_v1" material="charcoal"/>
                <geom class="visual" pos="0 -0.028 0.0181" quat="0.5 -0.5 -0.5 -0.5"
                      mesh="wrist_roll_pitch_so101_v2" material="light_grey"/>
                <geom class="collision" pos="0 -0.028 0.0181" quat="0.5 -0.5 -0.5 -0.5"
                      mesh="wrist_roll_pitch_so101_v2" material="light_grey"/>

                <body name="gripper_link" pos="0 -0.0611 0.0181" quat="0 0 0.707107 0.707107">
                  <joint axis="0 0 1" name="wrist_roll_joint" range="-2.74385 2.84121" class="sts3215"/>
                  <inertial pos="0.000213627 0.000245138 -0.025187" mass="0.087"
                            fullinertia="2.75087e-05 4.33657e-05 3.45059e-05 -3.35241e-07 -5.7352e-06 -5.17847e-08"/>
                  <geom class="visual" pos="0.0077 0.0001 -0.0234" quat="0.707107 -0.707107 0 0"
                        mesh="sts3215_03a_v1" material="charcoal"/>
                  <geom class="collision" pos="0.0077 0.0001 -0.0234" quat="0.707107 -0.707107 0 0"
                        mesh="sts3215_03a_v1" material="charcoal"/>
                  <geom class="visual" pos="0 -0.000218214 0.000949706" quat="0 1 0 0"
                        mesh="wrist_roll_follower_so101_v1" material="light_grey"/>
                  <geom class="collision" pos="0 -0.000218214 0.000949706" quat="0 1 0 0"
                        mesh="wrist_roll_follower_so101_v1" material="light_grey"/>
                  <!-- TCP marker, matches URDF's fixed end_effector_joint (end_effector_xyz/rpy
                       in so101.common.xacro) - not the ros2_so_arm MJCF's site, which does not
                       match that URDF's own rpy. -->
                  <site group="5" name="end_effector_link" pos="-0.0079 -0.000218121 -0.0981274" quat="0.707105 0 0.707108 0"/>

                  <!-- moving_jaw_link pos/quat recomputed from so101.common.xacro's gripper_xyz/gripper_rpy
                       directly (see file header) - so_arm_description's gripper_rpy has no pitch
                       offset, unlike ros2_so_arm's so_arm101_macro.xacro (0.18 rad, undocumented). -->
                  <body name="moving_jaw_link" pos="0.0202 0.0188 -0.0234" quat="0.707105 0.707108 0 0">
                    <joint axis="0 0 1" name="gripper_joint" range="-0.174533 1.74533" class="sts3215"/>
                    <inertial pos="-0.00157495 -0.0300244 0.0192755" mass="0.012"
                              fullinertia="6.61427e-06 1.89032e-06 5.28738e-06 -3.19807e-07 -5.90717e-09 -1.09945e-07"/>
                    <geom class="visual" pos="0 0 0.0189" quat="1 0 0 0"
                          mesh="moving_jaw_so101_v1" material="light_grey"/>
                    <geom class="collision" pos="0 0 0.0189" quat="1 0 0 0"
                          mesh="moving_jaw_so101_v1" material="light_grey"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </xacro:macro>

    <xacro:if value="${'$(arg standalone)' == 'true'}">
      <contact>
        <exclude body1="base_link" body2="shoulder_link"/>
        <exclude body1="shoulder_link" body2="upper_arm_link"/>
        <exclude body1="upper_arm_link" body2="lower_arm_link"/>
        <exclude body1="lower_arm_link" body2="wrist_link"/>
        <exclude body1="wrist_link" body2="gripper_link"/>
        <exclude body1="gripper_link" body2="moving_jaw_link"/>
      </contact>
      <worldbody>
        <xacro:so_arm101_body/>
      </worldbody>
    </xacro:if>
  </xacro:if>

  <!-- Compares $(arg standalone) directly, not via a bridged <xacro:property> - xacro
       auto-coerces "true"/"false" property values to Python bool, breaking a naive
       string comparison. -->
  <xacro:if value="${'$(arg standalone)' == 'true'}">
    <statistic center="0.1 -0.01 0.05" extent="0.5"/>

    <visual>
      <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
      <rgba haze="0.15 0.25 0.35 1"/>
      <global azimuth="45" elevation="-20"/>
    </visual>

    <asset>
      <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
      <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
        markrgb="0.8 0.8 0.8" width="300" height="300"/>
      <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    </asset>

    <worldbody>
      <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
      <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    </worldbody>
  </xacro:if>
</mujoco>
