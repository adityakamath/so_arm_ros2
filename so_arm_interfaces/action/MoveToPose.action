# Target end-effector pose in base frame (or caller-chosen frame, if already aligned).
geometry_msgs/PoseStamped target_pose
# Wrist roll angle in radians; pitch/yaw remain the IK solver's configured defaults.
float64 wrist_roll
# Optional one-shot gripper command applied once the pose is reached.
bool use_gripper
float64 gripper_position
# Position tolerance in meters. If <= 0, server default is used.
float64 position_tolerance
# Goal timeout in seconds. If <= 0, server default is used.
float64 timeout_sec
---
bool success
string message
float64 final_position_error
---
float64 position_error
